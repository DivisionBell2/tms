# Зависимости
node_modules/
.pnpm-store/

# Сборка
dist/
build/
*.tsbuildinfo
.next/
.svelte-kit/

# Случайно скомпилированный JS рядом с TS-исходниками (реальная сборка идёт в dist/)
packages/contracts/src/**/*.js
packages/contracts/src/**/*.js.map

# Скомпилированный prisma.config (конфиг живёт в prisma.config.ts, .js ломает prisma generate)
apps/*/prisma.config.js
apps/*/prisma.config.js.map

# Логи
*.log
npm-debug.log*
pnpm-debug.log*

# Переменные окружения
.env
.env.*
!.env.example

# IDE
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# Системные файлы
.DS_Store
Thumbs.db

# Тесты
coverage/
.nyc_output/

# Prisma (сгенерированный клиент — создаётся через prisma generate)
apps/*/src/generated/

# Storage
apps/file-service/storage/
!apps/file-service/storage/.gitkeep