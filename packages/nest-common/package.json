{
    "name": "@tms/nest-common",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "description": "Общие строительные блоки NestJS для NATS-микросервисов TMS",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@tms/contracts": "workspace:*"
    },
    "peerDependencies": {
        "@nestjs/common": "^11.0.1",
        "@prisma/adapter-pg": "^7.8.0",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@nestjs/common": "^11.0.1",
        "@prisma/adapter-pg": "^7.8.0",
        "rxjs": "^7.8.1",
        "typescript": "6.0.3"
    }
}