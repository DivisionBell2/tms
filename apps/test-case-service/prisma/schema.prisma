generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TestCaseStatus {
  draft
  manual
  automated
}

enum TestCaseTaskStatus {
  open
  done
}

model TestCase {
  id            String         @id @default(uuid())
  authorId      String
  authorName    String         @default("")
  title         String
  description   String
  status        TestCaseStatus @default(draft)
  preconditions String         @default("")
  tags          String[]       @default([])
  isCritical    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  sectionId String?

  steps   TestCaseStep[]
  tasks   TestCaseTask[]
  section TestCaseSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([authorName])
  @@index([status])
  @@index([isCritical])
  @@index([sectionId])
  @@map("test_cases")
}

model TestCaseSection {
  id        String   @id @default(uuid())
  name      String
  parentId  String?
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parent    TestCaseSection?  @relation("SectionTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  TestCaseSection[] @relation("SectionTree")
  testCases TestCase[]

  @@index([parentId])
  @@index([isPinned])
  @@map("test_case_sections")
}

model TestCaseStep {
  id             String @id @default(uuid())
  testCaseId     String
  order          Int
  action         String
  expectedResult String @default("")

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("test_case_steps")
}

model TestCaseTask {
  id         String             @id @default(uuid())
  testCaseId String
  title      String
  status     TestCaseTaskStatus @default(open)

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("test_case_tasks")
}
