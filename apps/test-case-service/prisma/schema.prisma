generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  runtime      = "nodejs"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum TestCaseStatus {
  draft
  manual
  automated
}

enum TestCaseTaskStatus {
  open
  done
}

model TestCase {
  id            String         @id @default(uuid())
  authorId      String
  authorName    String         @default("")
  title         String
  description   String
  status        TestCaseStatus @default(draft)
  preconditions String         @default("")
  tags          String[]       @default([])
  isCritical    Boolean        @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  steps TestCaseStep[]
  tasks TestCaseTask[]

  @@index([authorName])
  @@index([status])
  @@index([isCritical])
  @@map("test_cases")
}

model TestCaseStep {
  id String @id @default(uuid())
  testCaseId String
  order Int
  action String
  expectedResult String @default("")

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("test_case_steps")
}

model TestCaseTask {
  id String @id @default(uuid())
  testCaseId String
  title String
  status TestCaseTaskStatus @default(open)

  testCase TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  @@index([testCaseId])
  @@map("test_case_tasks")
}
