{
  "name": "tms",
  "version": "0.0.1",
  "private": true,
  "description": "Test Management System",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run build:contracts && pnpm -r typecheck",
    "build:contracts": "pnpm --filter @tms/contracts build",
    "build:packages": "pnpm --filter \"./packages/*\" -r run build",
    "build": "pnpm run build:contracts && pnpm -r --filter './apps/*' run build",
    "dev": "concurrently -n auth,files,gateway,cases,web -c blue,yellow,green,cyan,magenta \"pnpm --filter @tms/auth-service dev \" \"pnpm --filter @tms/file-service dev\" \"pnpm --filter @tms/api-gateway dev\" \"pnpm --filter @tms/test-case-service dev\" \"pnpm --filter @tms/web dev\"",
    "dev:infra": "docker compose up -d",
    "prisma:migrate": "bash scripts/prisma-migrate.sh",
    "prisma:generate": "pnpm --filter \"./apps/*\" -r --if-present run prisma:generate",
    "prisma:deploy": "pnpm --filter \"./apps/*\" -r --if-present run prisma:deploy"
  },
  "dependencies": {
    "@tms/contracts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@nestjs/cli": "11.0.21",
    "concurrently": "^10.0.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.10.0",
    "prettier": "3.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3"
  }
}
