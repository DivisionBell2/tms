{
  "name": "tms",
  "version": "0.0.1",
  "private": true,
  "description": "Test Management System",
  "packageManager": "pnpm@11.2.2+sha512.36e6621fad506178936455e70247b8808ef4ec25797a9f437a93281a020484e2607f6a469a22e982987c3dbb8866e3071514ab10a4a1749e06edcd1ec118436f",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm run build:contracts && pnpm -r typecheck",
    "build:contracts": "pnpm --filter @tms/contracts build",
    "build": "pnpm run build:contracts && pnpm -r --filter './apps/*' run build",
    "dev": "concurrently -n auth,gateway,web -c blue,green,magenta \"pnpm --filter @tms/auth-service dev \" \"pnpm --filter @tms/api-gateway dev\" \"pnpm --filter @tms/web dev\"",
    "dev:infra": "docker compose up -d"
  },
  "dependencies": {
    "@tms/contracts": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@nestjs/cli": "11.0.21",
    "concurrently": "^10.0.0",
    "eslint": "^9.12.0",
    "eslint-config-prettier": "9.1.0",
    "globals": "15.10.0",
    "prettier": "3.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.3"
  }
}
